# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://job_scraper:job_scraper@postgres:5432/job_scraper

# --- Queue / cache ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM provider (ollama | openai | anthropic) ---
# ollama = self-hosted, zero API cost, runs in the `ollama` container in
# docker-compose.prod.yml. See docs/deployment.md ("Choosing an Ollama model") for
# RAM-based sizing — llama3.2:3b for a 12GB VM, llama3.1:8b for 24GB.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embedding provider (sentence_transformers | openai) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability ---
SENTRY_DSN=

# --- Production only: the backend's public HTTPS hostname (Caddy gets a Let's
# Encrypt cert for it automatically). See docs/deployment.md — DuckDNS by default.
API_DOMAIN=

# --- Frontend ---
# Local dev only — in production the frontend is on Cloudflare Pages (a different
# origin than the API), so API_CORS_ORIGINS must list its real URL(s) there instead
# of localhost:5173. VITE_API_BASE_URL is a *build-time* value for Cloudflare Pages
# (set it in the Pages project's environment variables, not here) — see
# docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173
