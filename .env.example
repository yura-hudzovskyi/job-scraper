# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://job_scraper:job_scraper@postgres:5432/job_scraper

# --- Queue / cache ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM provider (ollama | openai | anthropic) ---
# LLM_MODEL, OLLAMA_FALLBACK_MODEL, GROQ_MODEL and GEMINI_MODEL below are only the
# *startup* defaults — once the app is running, any of them can also be changed
# from the System page in the UI (backed by Redis, not this file) and takes
# effect on the very next call, no redeploy needed; "Clear Redis" on that page
# reverts everything back to whatever's set here. See
# app/config/runtime_settings.py and app/api/routes/ai_settings.py.
# The base/fallback tier everything else degrades to — ollama = self-hosted, zero
# API cost, runs in the `ollama` container in docker-compose.prod.yml. See
# docs/deployment.md ("Choosing an Ollama model") for RAM-based sizing —
# llama3.2:3b for a 12GB VM, qwen2.5:14b for a 24GB (4 OCPU) VM. This is what
# LLM_PROVIDER=ollama uses directly, and what CV analysis/preferences AI-fill
# fall back to if GEMINI_API_KEY isn't set (see GEMINI_MODEL below) — the job
# pipeline (skill extraction, AI matching) has its own, smaller fallback model,
# OLLAMA_FALLBACK_MODEL, since it needs to actually finish quickly under load.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://ollama:11434
# The job pipeline's own local model — used directly if GROQ_API_KEY isn't set
# at all, or as the fallback once it is set and its rate limit trips. Deliberately
# independent of LLM_MODEL above (which is what CV analysis/preferences AI-fill
# fall back to instead): pick something small/fast here, since this leg needs to
# finish in reasonable time under Celery's concurrent load, not be the best
# quality model available locally — a 3-4B-class model is worth trying if even
# an 8B one feels slow under real load.
OLLAMA_FALLBACK_MODEL=llama3.1:8b
# Ollama silently truncates the prompt past this many tokens instead of erroring —
# job descriptions and CV text are sent in full, uncut, so this has to cover the
# longest real postings/CVs, not just the typical case. qwen2.5:14b/qwen3:14b
# natively support up to 32768 — raise toward that if truncation is still observed
# in practice (costs more KV-cache RAM and somewhat slower inference).
OLLAMA_NUM_CTX=16384
# How long the app waits for one Ollama response. A single isolated qwen2.5:14b
# CPU inference is ~60-90s, but Celery can have several tasks calling Ollama at
# once (e.g. during "rescore all vacancies") — those requests queue up behind
# each other rather than each taking the isolated-case time, so this needs real
# headroom. Also see OLLAMA_NUM_PARALLEL below — without it, concurrent requests
# can run *in parallel* instead of queueing, which on a 24GB box means two 14B
# inferences (~13GB each) competing for RAM at once, both taking far longer than
# either would alone (and possibly still failing this timeout).
OLLAMA_TIMEOUT_SECONDS=600
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: Gemini free tier for CV analysis + preferences AI-fill ---
# When set, these two low-volume, quality-matters-most call sites try Gemini's
# free tier first, falling back to LLM_MODEL on Ollama automatically the moment
# Gemini returns 429 (quota exceeded) — never on other errors, so a bad key
# still fails loudly. The UI shows which model actually produced each result
# either way. Get a free key at https://aistudio.google.com/apikey. Leave blank
# to use LLM_PROVIDER for these too.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Optional: Groq free tier for the job pipeline (skill extraction, AI
# matching, "should I apply?") ---
# This is the high-volume side — once per scraped job, once per (job, user) — so
# it deliberately does NOT share Gemini's quota above. Groq runs open models on
# dedicated inference hardware (a response in ~1-2s, not CPU-bound minutes), so
# it's what actually makes processing a real backlog (hundreds+ of jobs)
# practical. Falls back to OLLAMA_FALLBACK_MODEL the moment Groq returns 429; a
# short cooldown (GROQ_CIRCUIT_BREAKER_COOLDOWN_SECONDS) then skips straight to
# Ollama on the calls right after, instead of re-trying Groq and hitting the same
# wall on every job. Get a free key at https://console.groq.com/keys. Leave
# blank to use LLM_PROVIDER for the job pipeline too (i.e. no Groq at all).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Newer/preview Groq models (e.g. qwen/qwen3.6-27b, qwen/qwen3.8-27b,
# openai/gpt-oss-120b) carry much tighter free-tier caps than GA models like the
# default above — historically ~30 requests/min, ~1,000 requests/day, ~200K
# tokens/day per console.groq.com/docs/rate-limits (verify your own account's
# actual limits there; Groq can change these). LlmReranker's prompt (full job
# description + candidate profile), run for every CONSIDER+APPLY match, can burn
# through that token budget well before the request-count cap does. If a model
# "doesn't work" under real volume, that's usually this — constant 429s silently
# falling back to the slower OLLAMA_FALLBACK_MODEL below, not a broken model id.
# Use the System page's "Test model" button to check a candidate model actually
# responds before committing to it.
GROQ_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# Hard daily ceiling on LlmReranker calls, independent of whatever rate limits the
# provider above already enforces — see app/integrations/ai/llm/budget.py. It's the
# only LLM call site left in the job pipeline (scoring itself is fully
# deterministic) and runs on every CONSIDER+APPLY match, not just APPLY, so tune
# this to your actual daily match volume and provider quota.
LLM_RERANK_DAILY_LIMIT=150

# --- Embedding provider (sentence_transformers | openai) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Second signal blended into semantic_fit on top of the bi-encoder cosine
# similarity above (see app/domain/matching/scoring.py::SemanticScorer) — runs
# locally via sentence-transformers' CrossEncoder, no extra API/cost. Leave blank
# to disable and use pure bi-encoder cosine similarity. BAAI/bge-reranker-base is
# a heavier, more accurate opt-in swap (~5-10x slower on CPU).
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_WEIGHT=0.5

# --- Scraping ---
# Each tick scrapes ONE category (rotating through every category configured in
# app/integrations/sources/categories.py, oldest-scraped-first) instead of a fixed
# default feed, capped at SCRAPE_MAX_JOBS_PER_RUN listings. See docs/source-adapters.md.
SCRAPE_INTERVAL_SECONDS=1800
SCRAPE_MAX_JOBS_PER_RUN=100

# How many days a job stays in the DB after it was last seen in a scrape before
# it (and its matches/notifications) get deleted. Runs once daily.
JOB_RETENTION_DAYS=18

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Approve/Reject swipe-card button taps arrive via a Telegram webhook, registered
# automatically at API startup against API_DOMAIN below — see docs/notifications.md.
# Requires API_DOMAIN to be set; local dev without a public URL just never
# registers one (no error). Leave blank to derive the secret automatically from
# SECRET_KEY instead of managing a second one — set it explicitly only to rotate
# the webhook secret independently.
TELEGRAM_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- Production only: the backend's public HTTPS hostname (Caddy gets a Let's
# Encrypt cert for it automatically, and the Telegram webhook above is registered
# against it). See docs/deployment.md — DuckDNS by default.
API_DOMAIN=

# --- Frontend ---
# Local dev only — in production the frontend is on Cloudflare Pages (a different
# origin than the API), so API_CORS_ORIGINS must list its real URL(s) there instead
# of localhost:5173. VITE_API_BASE_URL is a *build-time* value for Cloudflare Pages
# (set it in the Pages project's environment variables, not here) — see
# docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173
