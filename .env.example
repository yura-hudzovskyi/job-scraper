# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://job_scraper:job_scraper@postgres:5432/job_scraper

# --- Queue / cache ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM providers ---
# The pipeline runs on two free hosted tiers, Groq and Gemini, configured further
# below. GROQ_MODEL and GEMINI_MODEL are only the *startup* defaults — once the
# app is running, both can also be changed from the System page in the UI (backed
# by Redis, not this file) and take effect on the very next call, no redeploy
# needed; "Clear Redis" on that page reverts them to whatever's set here. See
# app/config/runtime_settings.py and app/api/routes/ai_settings.py.
#
# LLM_PROVIDER/LLM_MODEL are an optional *paid* extra leg (openai | anthropic),
# tried only after both free tiers. Leave both blank unless you'd rather not
# depend on a free tier at all.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: Gemini free tier for CV analysis + preferences AI-fill ---
# When set, these two low-volume, quality-matters-most call sites try Gemini's
# free tier first, falling back to Groq automatically the moment Gemini returns
# 429 (quota exceeded) — never on other errors, so a bad key still fails loudly.
# The UI shows which model actually produced each result either way. Get a free
# key at https://aistudio.google.com/apikey. Leave blank to run these on Groq
# instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Optional: Groq free tier for the job pipeline (skill extraction, AI
# matching, "should I apply?") ---
# This is the high-volume side — once per scraped job, once per (job, user) — so
# it deliberately does NOT share Gemini's quota above. Groq runs open models on
# dedicated inference hardware (a response in ~1-2s, not CPU-bound minutes), so
# it's what actually makes processing a real backlog (hundreds+ of jobs)
# practical. Falls back to Gemini the moment Groq returns 429, and the router
# then parks Groq for exactly as long as its own reset header says instead of
# re-trying it on every job (app/integrations/ai/routing/). Get a free key at
# https://console.groq.com/keys. Leave blank to run the job pipeline on Gemini
# instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Newer/preview Groq models (e.g. qwen/qwen3.6-27b, qwen/qwen3.8-27b,
# openai/gpt-oss-120b) carry much tighter free-tier caps than GA models like the
# default above — historically ~30 requests/min, ~1,000 requests/day, ~200K
# tokens/day per console.groq.com/docs/rate-limits (verify your own account's
# actual limits there; Groq can change these). LlmReranker's prompt (full job
# description + candidate profile), run for every CONSIDER+APPLY match, can burn
# through that token budget well before the request-count cap does. If a model
# "doesn't work" under real volume, that's usually this — constant 429s silently
# falling back to Gemini, not a broken model id.
# Use the System page's "Test model" button to check a candidate model actually
# responds before committing to it.

# --- Daily LLM budgets, one per capability ---
# Independent of whatever rate limits the providers above enforce — see
# app/integrations/ai/quota/budget.py. Separate counters are what protects the
# interactive work: a backlog run burning through job extraction cannot eat what
# CV analysis has left, because they never share a budget. The System page shows
# how much of each is used today; tune these to your own account's quotas.
LLM_DAILY_LIMIT_PROFILE_EXTRACTION=50
LLM_DAILY_LIMIT_JOB_EXTRACTION=400
LLM_DAILY_LIMIT_MATCH_ENRICHMENT=150

# --- Embedding provider (sentence_transformers | openai) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Second signal blended into semantic_fit on top of the bi-encoder cosine
# similarity above (see app/domain/matching/scoring.py::SemanticScorer) — runs
# locally via sentence-transformers' CrossEncoder, no extra API/cost. Leave blank
# to disable and use pure bi-encoder cosine similarity. BAAI/bge-reranker-base is
# a heavier, more accurate opt-in swap (~5-10x slower on CPU).
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_WEIGHT=0.5

# --- AI pipeline v3 rollout flags (docs/ai-pipeline-v3.md) ---
# Each flag turns on one stage of the new matching pipeline; all off means the
# app behaves exactly as it does today. Turn them on in order — LLM_ENRICHMENT
# does nothing while MATCHING_PIPELINE_V3 is off.
MULTI_EMBEDDING_LANES=false
MATCHING_PIPELINE_V3=false
LLM_ENRICHMENT=false

# --- Scraping ---
# Each tick scrapes ONE category (rotating through every category configured in
# app/integrations/sources/categories.py, oldest-scraped-first) instead of a fixed
# default feed, capped at SCRAPE_MAX_JOBS_PER_RUN listings. See docs/source-adapters.md.
SCRAPE_INTERVAL_SECONDS=1800
SCRAPE_MAX_JOBS_PER_RUN=100

# How many days a job stays in the DB after it was last seen in a scrape before
# it (and its matches/notifications) get deleted. Runs once daily.
JOB_RETENTION_DAYS=18

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Approve/Reject swipe-card button taps arrive via a Telegram webhook, registered
# automatically at API startup against API_DOMAIN below — see docs/notifications.md.
# Requires API_DOMAIN to be set; local dev without a public URL just never
# registers one (no error). Leave blank to derive the secret automatically from
# SECRET_KEY instead of managing a second one — set it explicitly only to rotate
# the webhook secret independently.
TELEGRAM_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- Production only: the backend's public HTTPS hostname (Caddy gets a Let's
# Encrypt cert for it automatically, and the Telegram webhook above is registered
# against it). See docs/deployment.md — DuckDNS by default.
API_DOMAIN=

# --- Frontend ---
# Local dev only — in production the frontend is on Cloudflare Pages (a different
# origin than the API), so API_CORS_ORIGINS must list its real URL(s) there instead
# of localhost:5173. VITE_API_BASE_URL is a *build-time* value for Cloudflare Pages
# (set it in the Pages project's environment variables, not here) — see
# docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173
