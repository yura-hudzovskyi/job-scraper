# Infrastructure only. Everything about *how the pipeline behaves* — models,
# batch sizes, the rerank weight, score thresholds, retention — lives in the
# database and is edited from the System page in the UI, so tuning it never means
# editing this file or redeploying.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- Database ---
# Needs the pgvector extension (the docker-compose image already has it).
DATABASE_URL=postgresql+psycopg://job_scraper:job_scraper@postgres:5432/job_scraper

# --- Queue / cache ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Voyage AI (required) ---
# The only model credential this app has, and the whole of its AI: one endpoint
# turns text into vectors, the other reads a CV and a vacancy together and scores
# the fit. Without this key there is no embedding search and no reranking, and
# the System page says so instead of quietly producing nothing.
# Get a key at https://dashboard.voyageai.com/. Which models it uses is set in
# the UI, not here.
VOYAGE_API_KEY=

# --- Telegram (optional) ---
# One shared bot; each user connects their own chat id from the Settings page.
# Leave the token blank to run without notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public HTTPS hostname Caddy fronts this API on (see Caddyfile,
# docs/deployment.md). Used to register the Telegram webhook at startup; leave
# blank in local dev, where there is no public URL to register.
API_DOMAIN=
# Shared secret Telegram echoes back on every webhook call. Leave blank to derive
# one from SECRET_KEY; set it to rotate the two independently.
TELEGRAM_WEBHOOK_SECRET=

# --- Scheduling ---
# How often the full pipeline runs (scrape -> embed -> match -> notify). This is
# the one pipeline number that can't be changed from the UI: Celery beat reads
# its schedule at startup, so changing it needs a beat restart.
SCRAPE_INTERVAL_SECONDS=1800

# --- Observability ---
SENTRY_DSN=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173
