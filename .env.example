# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://job_scraper:job_scraper@postgres:5432/job_scraper

# --- Queue / cache ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM provider (ollama | openai | anthropic) ---
# ollama = self-hosted, zero API cost, runs in the `ollama` container in
# docker-compose.prod.yml. See docs/deployment.md ("Choosing an Ollama model") for
# RAM-based sizing — llama3.2:3b for a 12GB VM, qwen2.5:14b for a 24GB (4 OCPU) VM.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://ollama:11434
# Ollama silently truncates the prompt past this many tokens instead of erroring —
# job descriptions and CV text are sent in full, uncut, so this has to cover the
# longest real postings/CVs, not just the typical case. qwen2.5:14b/qwen3:14b
# natively support up to 32768 — raise toward that if truncation is still observed
# in practice (costs more KV-cache RAM and somewhat slower inference).
OLLAMA_NUM_CTX=16384
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: Gemini free tier for CV analysis specifically ---
# When set, CV analysis (the one call site where quality matters most) tries
# Gemini's free tier first, falling back to Ollama automatically the moment
# Gemini returns 429 (quota exceeded) — never on other errors, so a bad key
# still fails loudly. Job skill extraction always uses Ollama regardless, since
# it runs on every scraped job and would burn the free-tier quota fast. The UI
# shows which model actually produced each result either way. Get a free key at
# https://aistudio.google.com/apikey. Leave blank to use LLM_PROVIDER for
# everything, unchanged from before this existed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embedding provider (sentence_transformers | openai) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Scraping ---
# Each tick scrapes ONE category (rotating through every category configured in
# app/integrations/sources/categories.py, oldest-scraped-first) instead of a fixed
# default feed, capped at SCRAPE_MAX_JOBS_PER_RUN listings. See docs/source-adapters.md.
SCRAPE_INTERVAL_SECONDS=1800
SCRAPE_MAX_JOBS_PER_RUN=100

# How many days a job stays in the DB after it was last seen in a scrape before
# it (and its matches/notifications) get deleted. Runs once daily.
JOB_RETENTION_DAYS=18

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability ---
SENTRY_DSN=

# --- Production only: the backend's public HTTPS hostname (Caddy gets a Let's
# Encrypt cert for it automatically). See docs/deployment.md — DuckDNS by default.
API_DOMAIN=

# --- Frontend ---
# Local dev only — in production the frontend is on Cloudflare Pages (a different
# origin than the API), so API_CORS_ORIGINS must list its real URL(s) there instead
# of localhost:5173. VITE_API_BASE_URL is a *build-time* value for Cloudflare Pages
# (set it in the Pages project's environment variables, not here) — see
# docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173
